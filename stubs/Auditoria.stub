<?php

declare(strict_types=1);

namespace Src\App\Services\Auditoria;

use Src\App\Infrastructure\IRepositories\I{{Modulo}}Repository;
use Src\App\Models\{{Modulo}};
use Src\App\Services\IServices\IAuditoriaService;

class Auditoria{{Modulo}} implements I{{Modulo}}Repository
{
    public function __construct(
        private I{{Modulo}}Repository $repository,
        private IAuditoriaService $auditoriaService
    ) {
    }

    public function create({{Modulo}} ${{ModuloVariavel}}): {{Modulo}}
    {
        $criado = $this->repository->create(${{ModuloVariavel}});
        $this->auditoriaService->registrar(
            $_SESSION['user_id'] ?? null,
            '{{Modulo}}',
            'create',
            $criado->getId(),
            ['titulo' => $criado->getTitulo(), 'descricao' => $criado->getDescricao()]
        );
        return $criado;
    }

    public function update({{Modulo}} ${{ModuloVariavel}}): {{Modulo}}
    {
        $antes = $this->repository->getById(${{ModuloVariavel}}->getId());
        $atualizado = $this->repository->update(${{ModuloVariavel}});
        $this->auditoriaService->registrar(
            $_SESSION['user_id'] ?? null,
            '{{Modulo}}',
            'update',
            $atualizado->getId(),
            [
                'antes'  => ['titulo' => $antes?->getTitulo(), 'descricao' => $antes?->getDescricao()],
                'depois' => ['titulo' => $atualizado->getTitulo(), 'descricao' => $atualizado->getDescricao()],
            ]
        );
        return $atualizado;
    }

    public function delete(string $id): bool
    {
        $deleted = $this->repository->delete($id);
        if ($deleted) {
            $this->auditoriaService->registrar(
                $_SESSION['user_id'] ?? null,
                '{{Modulo}}',
                'delete',
                $id,
                ['id' => '{{Modulo}} com id ' . $id . ' deletado']
            );
        }
        return $deleted;
    }

    public function getAll(): array
    {
        return $this->repository->getAll();
    }

    public function getById(string $id): ?{{Modulo}}
    {
        return $this->repository->getById($id);
    }

    public function count(): int
    {
        return $this->repository->count();
    }
}