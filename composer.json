{
  "name": "sistema/mvc-base",
  "description": "Framework MVC PHP modular — base para projetos em equipe",
  "autoload": {
    "psr-4": {
      "Src\\": "src/"
    },
    "files": 
    [
      "src/Core/Helpers.php"
    ]
  },
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "larapack/dd": "^1.1",
    "zircote/swagger-php": "^6.1",
    "ramsey/uuid": "^4.9"
  },
  "require-dev": {
    "nunomaduro/phpinsights": "^2.14",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "criar": "php bin/make-modulo.php",
    "remover": "php bin/remove-modulo.php",
    "metodo": "php bin/make-method.php"
  }
}
